{
  "name": "kitchenlab",
  "version": "1.0.0",
  "private": true,
  "description": "KitchenLab - GitHub for Recipes",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev-server": "node --watch server/index.js",
    "dev-client": "cd client && npx vite --port 5173",
    "dev": "npx concurrently \"npm run dev-server\" \"npm run dev-client\"",
    "build": "cd client && npx vite build",
    "preview": "cd client && npx vite preview"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "concurrently": "^8.2.0"
  }
}